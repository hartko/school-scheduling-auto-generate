# URL of the NestJS backend API
NESTJS_BASE_URL=http://localhost:4000

# How many records to fetch per page when paginating NestJS endpoints
NESTJS_PAGE_SIZE=100

# Seconds before an HTTP request to NestJS times out
NESTJS_TIMEOUT_SECONDS=30.0

# How many times to retry a failed NestJS request before giving up
NESTJS_MAX_RETRIES=3

# Default time (seconds) the CP-SAT solver is allowed to run before returning best result
DEFAULT_SOLVER_TIME_LIMIT_SECONDS=60

# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
